# Copy this file to .env (project root, used by docker-compose) and fill in real values.
# Never commit .env itself.

# Required: your Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default model
GEMINI_MODEL=gemini-2.5-flash

# Required in production: a long random string used to sign JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-in-production

# Postgres connection string. The docker-compose default works out of the box;
# override for a managed Postgres instance (RDS, Supabase, Neon, etc).
DATABASE_URL=postgresql+psycopg2://leasecheck:leasecheck@localhost:5432/leasecheck

# Optional: comma-separated list of allowed CORS origins in production
# e.g. https://your-app.awsapprunner.com
ALLOWED_ORIGINS=*

# Used to build password-reset links (must match where the frontend is served)
FRONTEND_URL=http://localhost:5173
